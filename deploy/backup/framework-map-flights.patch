+// verify private settings only with a compatible selected release
+test('U-ARC-ADSB map.flights settings require the exact immutable schema marker', async () => {
+  const root = await createTestRoot()
+
+  try {
+    const fixture = await createAdsbFixtureConfig(root)
+    const path = 'opt/adsb/current/deploy/settings-schema.json'
+    const marker = JSON.stringify({ schema_version: 2, optional_network: 'mapflights' })
+    const legacy = {
+      revision: 17,
+      station: { name: 'Fixture station', latitude: 47, longitude: -122, altitude_m: 30 },
+      networks: Object.fromEntries(['adsbexchange', 'flightaware', 'adsblol', 'airplaneslive']
+        .map((key) => [key, { enabled: false, mlat: false, feeder_id: '' }]))
+    }
+    const mapflights = { enabled: true, mlat: true, feeder_id: '22222222-2222-4222-8222-222222222222' }
+    const withMapFlights = (network) => ({ ...legacy, networks: { ...legacy.networks, mapflights: network } })
+    const configured = withMapFlights(mapflights)
+    const markerFile = [[path, marker, 0o644]]
+
+    // accept legacy archives and attributed current archives
+    for (const [name, settings, extraFiles] of [
+      ['legacy', legacy, []],
+      ['sparse', legacy, markerFile],
+      ['configured', configured, markerFile]
+    ]) {
+      assert.equal((await verifyAdsbVariant(root, fixture, `mapflights-${name}`, { settings, extraFiles })).archiveVerified, true)
+    }
+
+    // fail closed on incompatible release metadata, shape or configuration
+    for (const [name, settings, extraFiles] of [
+      ['missing', configured, []],
+      ['wrong-mode', configured, [[path, marker, 0o755]]],
+      ['oversize', configured, [[path, marker + ' '.repeat(1024), 0o644]]],
+      ['extra-key', configured, [[path, '{"schema_version":2,"optional_network":"mapflights","extra":true}', 0o644]]],
+      ['wrong-release', configured, [['opt/adsb/current/deploy/other-schema.json', marker, 0o644]]],
+      ['legacy-invalid-marker', legacy, [[path, '{}', 0o644]]],
+      ['invalid-id', withMapFlights({ ...mapflights, feeder_id: mapflights.feeder_id + '\n' }), markerFile],
+      ['orphan-mlat', withMapFlights({ ...mapflights, enabled: false }), markerFile]
+    ]) {
+      await assert.rejects(verifyAdsbVariant(root, fixture, `mapflights-${name}`, { settings, extraFiles }), { code: 'CONTENT_INVALID' })
+    }
+  } finally {
+    await removeTestRoot(root)
+  }
+})
